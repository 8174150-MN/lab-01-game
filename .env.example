# Copy this file to .env for a local production-like Docker run.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
ENABLE_DEMOS=false
ALLOWED_ORIGINS=http://localhost:3000
MAX_CONNECTIONS_PER_IP=20
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=10
MAX_MESSAGE_BYTES=2048
MAX_MESSAGES_PER_SECOND=120
TRUST_PROXY=false
BUILD_SHA=local
BUILD_VERSION=dev
