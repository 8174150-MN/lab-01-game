{
  "name": "dogfight",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "test": "npm run test -w client && npm run test -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:rss": "node server/bench/replay-backpressure.js"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1"
  }
}
