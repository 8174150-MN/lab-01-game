# HTTP server bind port.
PORT=3000
# Host interface used by node:http.
HOST=127.0.0.1
# Folder for NDJSON logs; relative paths are based on server/.
LOG_DIR=./logs
# Maximum simultaneous rooms held in memory.
MAX_ROOMS=20
# Maximum players allowed in one room.
MAX_PLAYERS_PER_ROOM=10
# Maximum WebSocket frame size in bytes.
MAX_MESSAGE_BYTES=2048
# Messages allowed per second for one socket.
MAX_MESSAGES_PER_SECOND=30
# Set false to disable the slow-response lab demonstration.
ENABLE_DEMOS=true
